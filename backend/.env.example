# Copy this file to .env and fill in real values. .env itself is gitignored.

DATABASE_URL="postgresql://user:password@host:port/dbname"
PORT=4000

# Timezone used to resolve "today" for week/session boundaries — should match
# where you actually train, not the server's default.
APP_TZ="America/New_York"

# Whoop OAuth (register an app at https://developer.whoop.com)
# Redirect URI must exactly match what's registered on the Whoop app, e.g.
# http://localhost:4000/api/integrations/whoop/callback for local dev, or
# https://<your-railway-domain>/api/integrations/whoop/callback in production.
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=
